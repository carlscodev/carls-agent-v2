{
  "name": "carls-code",
  "version": "0.3.0",
  "description": "Autonomous AI coding agent CLI harness (Gather-Act-Verify, compaction, sub-agents, permission gate).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "carls": "./bin/carls.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node ./bin/carls.mjs",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:eol": "vitest run -t \"line endings\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "globby": "^14.0.2",
    "picocolors": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "husky": "^9.1.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
